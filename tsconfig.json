{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "offchain/**/*.ts",
    "indexer/**/*.ts",
    "verifier/**/*.ts",
    "web/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts"
  ]
}
