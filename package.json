{
  "name": "cardano-agent-arena",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <27"
  },
  "scripts": {
    "build:validators": "node scripts/aiken.mjs build",
    "check:validators": "node scripts/aiken.mjs check",
    "generate": "node --experimental-strip-types scripts/generate-blueprint.ts",
    "check:generated": "node --experimental-strip-types scripts/generate-blueprint.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "test:e2e": "node --experimental-strip-types test/devnet.e2e.ts",
    "devnet": "node --experimental-strip-types scripts/devnet.ts",
    "index": "node --experimental-strip-types indexer/cli.ts",
    "verifier": "node --experimental-strip-types verifier/cli.ts",
    "web": "node --experimental-strip-types web/server.ts"
  },
  "devDependencies": {
    "@aiken-lang/aiken": "1.1.24",
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@blaze-cardano/core": "0.9.0",
    "@blaze-cardano/data": "0.6.8",
    "@blaze-cardano/ogmios": "0.0.7",
    "@blaze-cardano/sdk": "0.3.1",
    "@lucid-evolution/plutus": "0.1.36",
    "@scure/base": "1.2.6"
  },
  "overrides": {
    "@blaze-cardano/core": "0.9.0",
    "@blaze-cardano/data": "0.6.8",
    "@blaze-cardano/uplc": "0.5.1",
    "@blaze-cardano/tx": "0.15.1",
    "@blaze-cardano/wallet": "0.6.1",
    "@blaze-cardano/query": "0.6.1",
    "@blaze-cardano/vm": "0.3.1",
    "@blaze-cardano/sdk": "0.3.1",
    "@blaze-cardano/ogmios": "0.0.7"
  }
}
